# Marginalia environment contract (§4). Copy to .env and fill in.
# .env is gitignored; never commit real secrets.

# libSQL database URL. Local file in dev; Fly volume path in prod.
#   dev:  file:./data/app.db
#   prod: file:/data/app.db   (set in fly.toml)
# Escape hatch: point this at a Turso libSQL URL (+ DATABASE_AUTH_TOKEN) with no code change.
DATABASE_URL=file:./data/app.db

# Optional: auth token when DATABASE_URL points at a remote Turso DB. Empty for local file.
DATABASE_AUTH_TOKEN=

# HTTP port the server binds. Platform sets this in prod.
PORT=8080

# Shared bearer token protecting everything under /api (except /api/healthz).
# Generate with: openssl rand -hex 32   (see README §7.4)
APP_TOKEN=

# Anthropic API key for on-demand LLM summaries (Phase 4). Starts with sk-ant-.
# (see README §7.2)
ANTHROPIC_API_KEY=

# Current Haiku-tier model id (verify against Anthropic docs).
ANTHROPIC_MODEL=claude-haiku-4-5

# Path to the declarative source list.
SOURCES_CONFIG_PATH=./config/sources.yaml
